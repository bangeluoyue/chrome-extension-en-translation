{
  "manifest_version": 3,
  "name": "网页翻译",
  "version": "0.1.0",
  "description": "提取网页文章正文，转换为 Markdown 并调用 AI 翻译",
  "action": {
    "default_popup": "popup.html",
    "default_title": "网页翻译"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "sidePanel",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
